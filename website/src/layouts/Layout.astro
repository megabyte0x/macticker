---
import '../styles/global.css';
import { buttonVariants } from '../components/ui/button';
const { title, description, schema, article = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title>{noindex && <meta name="robots" content="noindex"/>}<meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content={article ? 'article' : 'website'}/><meta property="og:site_name" content="Ticker"/><meta property="og:image" content="https://ticker.megabyte.sh/social.png"/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta name="twitter:card" content="summary_large_image"/>{schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/>}</head><body><a class="skip" href="#main">Skip to content</a><header class="site-header"><a href="/" class="brand"><span class="brand-mark" aria-hidden="true">T</span>Ticker</a><nav aria-label="Main navigation"><a href="/guides/">Guides</a><a href="/download/">Install</a><a href="/downloads/Ticker-1.0-arm64.dmg" download class={buttonVariants({className:"nav-download"})}>Download for Mac</a></nav></header><main id="main"><slot/></main><footer><a class="brand" href="/">Ticker</a><p>A small Mac app by <a href="https://megabyte.sh">Megabyte</a>.</p><nav aria-label="Footer"><a href="/guides/">Guides</a><a href="/privacy/">Privacy</a><a href="/download/">Download & installation</a></nav><p class="fine">Prices provided by <a href="https://www.coingecko.com/">CoinGecko</a>. Ticker displays market data and does not execute trades.</p></footer></body></html>
