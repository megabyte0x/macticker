---
import '../styles/global.css';
import { buttonVariants } from '../components/ui/button';
const { title, description, schema, article = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = new URL('/social.png', Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{title}</title>
{noindex && <meta name="robots" content="noindex"/>}
<meta name="description" content={description}/>
<link rel="canonical" href={canonical}/>
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
<link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
<meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)"/>
<meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)"/>
<meta name="color-scheme" content="light dark"/>
<meta property="og:title" content={title}/>
<meta property="og:description" content={description}/>
<meta property="og:url" content={canonical}/>
<meta property="og:type" content={article ? 'article' : 'website'}/>
<meta property="og:site_name" content="Ticker for Mac"/>
<meta property="og:locale" content="en_US"/>
<meta property="og:image" content={socialImage}/>
<meta property="og:image:width" content="1200"/>
<meta property="og:image:height" content="630"/>
<meta property="og:image:alt" content="Ticker app icon above the headline Keep a price in sight, beside the Ticker menu bar popup."/>
<meta name="twitter:card" content="summary_large_image"/>
<meta name="twitter:title" content={title}/>
<meta name="twitter:description" content={description}/>
<meta name="twitter:image" content={socialImage}/>
{schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/>}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="toolbar">
  <div class="toolbar-inner">
    <a href="/" class="brand"><img src="/favicon.svg" width="28" height="28" alt=""/>Ticker</a>
    <nav aria-label="Main navigation">
      <a href="/guides/">Guides</a>
      <a href="/download/">Install</a>
      <a href="/downloads/Ticker-1.0-arm64.dmg" download class={buttonVariants({className:"mac-button small"})}>Download</a>
    </nav>
  </div>
</header>
<main id="main"><slot/></main>
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand"><a class="brand" href="/"><img src="/favicon.svg" width="22" height="22" alt=""/>Ticker</a><p>A small Mac app by <a href="https://megabyte.sh">Megabyte</a>.</p></div>
    <nav aria-label="Footer"><a href="/download/">Download & installation</a><a href="/guides/">Guides</a><a href="/privacy/">Privacy</a></nav>
    <p class="fine">Prices provided by <a href="https://www.coingecko.com/">CoinGecko</a>. Ticker displays market data and does not execute trades. macOS is a trademark of Apple Inc.</p>
  </div>
</footer>
</body>
</html>
