---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const guides = await getCollection('guides');
---
<Layout title="Mac crypto ticker guides and alternatives | Ticker" description="Compare Mac crypto tickers, set up a Bitcoin menu bar price, and understand refresh intervals and watchlist settings."><section class="wrap page"><p class="eyebrow">Guides</p><h1>Small app.<br/>Useful details.</h1><p class="lede">How to set up a crypto ticker, choose an alternative and read the prices it shows.</p><ul class="guide-index">{guides.map(g=><li><a href={`/guides/${g.id}/`}><span class="article-meta">{g.data.category}</span><h2>{g.data.title}</h2><p>{g.data.description}</p></a></li>)}</ul></section></Layout>
