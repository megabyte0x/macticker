---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths(){return (await getCollection('guides')).map(guide=>({params:{slug:guide.id},props:{guide}}))}
const {guide} = Astro.props;
const {Content} = await render(guide);
const site = Astro.site.href.replace(/\/$/, '');
const url = `${site}/guides/${guide.id}/`;
const schema = {'@context':'https://schema.org','@graph':[{'@type':'Article',headline:guide.data.title,description:guide.data.description,datePublished:guide.data.date,dateModified:guide.data.date,author:{'@type':'Organization',name:'Megabyte',url:'https://megabyte.sh'},publisher:{'@type':'Organization',name:'Megabyte',url:'https://megabyte.sh'},mainEntityOfPage:url,image:`${site}/social.png`},{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Ticker',item:`${site}/`},{'@type':'ListItem',position:2,name:'Guides',item:`${site}/guides/`},{'@type':'ListItem',position:3,name:guide.data.title,item:url}]}]};
---
<Layout title={`${guide.data.title} | Ticker`} description={guide.data.description} schema={schema} article><article class="page"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/guides/">‹ All guides</a></nav><h1 class="article-title">{guide.data.title}</h1><p class="lede">{guide.data.description}</p><p class="article-meta">By Megabyte · Published October 1, 2026</p><div class="prose"><Content/></div><div class="notice"><h3>Try Ticker on your Mac</h3><p>Free for Apple Silicon Macs running macOS 26 or newer.</p><a class="text-link" href="/download/">Download and installation details ›</a></div></article></Layout>
