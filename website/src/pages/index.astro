---
import Layout from '../layouts/Layout.astro';
import { buttonVariants } from '../components/ui/button';
import FAQ from '../components/FAQ';
const site = Astro.site.href.replace(/\/$/, '');
const schema = {'@context':'https://schema.org','@graph':[
  {'@type':'WebSite','@id':`${site}/#website`,url:`${site}/`,name:'Ticker',alternateName:'Ticker for Mac',publisher:{'@id':'https://megabyte.sh/#organization'}},
  {'@type':'Organization','@id':'https://megabyte.sh/#organization',name:'Megabyte',url:'https://megabyte.sh'},
  {'@type':'SoftwareApplication','@id':`${site}/#app`,name:'Ticker',url:`${site}/`,image:`${site}/apple-touch-icon.png`,screenshot:`${site}/ticker-native.png`,operatingSystem:'macOS 26 or newer',processorRequirements:'Apple Silicon (arm64)',applicationCategory:'UtilitiesApplication',applicationSubCategory:'Menu bar crypto ticker',description:'A native macOS menu bar crypto ticker with a customizable watchlist, USD prices and 1-hour, 24-hour and 1-week percentage changes.',downloadUrl:`${site}/downloads/Ticker-1.0-arm64.dmg`,fileSize:'372 KB',softwareVersion:'1.0',author:{'@id':'https://megabyte.sh/#organization'},publisher:{'@id':'https://megabyte.sh/#organization'},offers:{'@type':'Offer',price:'0',priceCurrency:'USD'}}
]};
const download = buttonVariants({className:'mac-button large'});
---
<Layout title="Ticker: crypto prices in your Mac menu bar" description="Track Bitcoin, Ethereum and your crypto watchlist in the macOS menu bar. Native SwiftUI, no account or API key. Free Apple Silicon DMG for macOS 26+." schema={schema}>
<section class="hero">
  <img class="app-icon" src="/favicon.svg" width="112" height="112" alt="Ticker app icon" fetchpriority="high"/>
  <p class="eyebrow">Ticker for Mac</p>
  <h1>Keep a price in sight.</h1>
  <p class="hero-copy">Bitcoin, Ethereum and your watchlist, one click away in the macOS menu bar. Native SwiftUI. No account, no API key.</p>
  <div class="actions">
    <a href="/downloads/Ticker-1.0-arm64.dmg" download class={download}><svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 20h14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>Download for Mac</a>
    <a class="text-link" href="/download/">Installation details ›</a>
  </div>
  <p class="meta-line">Free · Version 1.0 · macOS 26 or later · Apple Silicon</p>
</section>

<figure class="desktop">
  <div class="menubar" aria-hidden="true">
    <div class="menubar-left"><strong>Finder</strong><span>File</span><span>Edit</span><span>View</span><span class="hide-sm">Go</span><span class="hide-sm">Window</span><span class="hide-sm">Help</span></div>
    <div class="menubar-right">
      <span class="status-item active">BTC $84,387.00</span>
      <svg class="hide-sm" viewBox="0 0 24 24" width="15" height="15"><path d="M2 9a15 15 0 0 1 20 0M5.5 12.5a10 10 0 0 1 13 0M9 16a5 5 0 0 1 6 0" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><circle cx="12" cy="19.5" r="1.4" fill="currentColor"/></svg>
      <svg class="hide-sm" viewBox="0 0 30 14" width="24" height="12"><rect x=".75" y=".75" width="25" height="12.5" rx="3.5" fill="none" stroke="currentColor" stroke-opacity=".55" stroke-width="1.5"/><rect x="3" y="3" width="17" height="8" rx="1.5" fill="currentColor"/><path d="M28 5v4" stroke="currentColor" stroke-opacity=".55" stroke-width="1.6" stroke-linecap="round"/></svg>
      <span>Wed 10:36 PM</span>
    </div>
  </div>
  <div class="popover">
    <picture><source srcset="/ticker-native.webp" type="image/webp"/><img class="native-preview" src="/ticker-native.png" width="640" height="590" alt="Ticker's native macOS popup, with stars on the left, token symbols above names, USD prices and the change-period selector."/></picture>
  </div>
  <figcaption class="preview-caption">Native Ticker interface rendered from the app's SwiftUI source. Prices shown at capture time.</figcaption>
</figure>

<section class="requirements" aria-label="Release details">
  <span>macOS 26+</span><span>Apple Silicon</span><span>Free download</span><a href="/download/#security">Signed & notarized ›</a>
</section>

<section class="section">
  <header class="section-head">
    <h2>A watchlist. Without another tab.</h2>
    <p>Add the tokens you follow. Star one to put its USD price in the menu bar. Your choices stay saved between launches.</p>
  </header>
  <dl class="tiles">
    <div class="tile"><dt><span class="tile-icon orange"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>Choose your time frame</dt><dd>Switch between 1-hour, 24-hour and 1-week percentage changes in the same popup.</dd></div>
    <div class="tile"><dt><span class="tile-icon blue"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg></span>Search by name or symbol</dt><dd>Press <kbd>⌘</kbd><kbd>N</kbd> or click + to find tokens on CoinGecko. <kbd>esc</kbd> returns to your watchlist.</dd></div>
    <div class="tile"><dt><span class="tile-icon red"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3 2 20h20L12 3Z"/><path d="M12 10v4m0 3v.01"/></svg></span>Know when data is stale</dt><dd>Prices refresh every minute. Ticker labels outdated data when the service cannot provide a fresh quote.</dd></div>
    <div class="tile"><dt><span class="tile-icon yellow"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1 6.2L12 17.3 6.5 20.2l1-6.2L3 9.6l6.2-.9L12 3Z"/></svg></span>Star the one that matters</dt><dd>The starred token's symbol and USD price sit in the menu bar. A tilde marks a price that is out of date.</dd></div>
  </dl>
</section>

<section class="section">
  <header class="section-head"><h2>From download to menu bar.</h2></header>
  <ol class="steps">
    <li><span class="step-num">1</span><h3>Move it to Applications</h3><p>Open the DMG and drag Ticker into Applications.</p></li>
    <li><span class="step-num">2</span><h3>Open Ticker</h3><p>Confirm the <a href="/download/#security">developer and notarization</a> if macOS asks, then look in the menu bar.</p></li>
    <li><span class="step-num">3</span><h3>Make it yours</h3><p>Add a token. Click its star. That price stays in sight.</p></li>
  </ol>
</section>

<section class="section narrow">
  <header class="section-head"><h2>A few details.</h2></header>
  <FAQ client:visible/>
</section>

<section class="closing">
  <img src="/favicon.svg" width="72" height="72" alt=""/>
  <h2>Ticker for Mac</h2>
  <p>Free for Apple Silicon Macs running macOS 26 or later.</p>
  <a href="/downloads/Ticker-1.0-arm64.dmg" download class={download}>Download for Mac</a>
</section>
</Layout>
